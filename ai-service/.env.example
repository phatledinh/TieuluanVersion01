# ── AI Service Environment Variables ──

# Neo4j Knowledge Graph (PDF 3.5)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Product Service (inter-service REST — PDF 4.5.1)
PRODUCT_SERVICE_URL=http://product-service:8001

# LLM Provider — Groq (PDF 3.6.1)
GROQ_API_KEY=your_groq_api_key_here

# Model paths
LSTM_MODEL_PATH=trained_models/lstm_model.pt
LSTM_META_PATH=trained_models/lstm_meta.json
FAISS_INDEX_PATH=trained_models/product_index.faiss
FAISS_MAPPING_PATH=trained_models/product_mapping.json
